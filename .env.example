# ==============================================================================
# The Virtus Labs (TVL) Agency Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Serverless Database
# ------------------------------------------------------------------------------
# Get your connection string from https://console.neon.tech
# Example: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (Media & Vault Assets)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=virtus-media-vault
CLOUDFLARE_R2_PUBLIC_URL=https://assets.thevirtuslabs.com

# ------------------------------------------------------------------------------
# 3. Stripe Payments & Invoicing
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. Cal.com Booking Webhook & Scheduling
# ------------------------------------------------------------------------------
CAL_API_KEY=
CAL_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. App & Studio Meta
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Access control (staff accounts and client sessions)
# ------------------------------------------------------------------------------
# Required in production. At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Invitation codes for /staff/register. Share as /staff/register#code=YOUR_CODE (the code stays out of server logs).
# STAFF_INVITE_CODE creates team members. ADMIN_INVITE_CODE creates admins (use it once to bootstrap the first admin).
# Leave a code empty to disable open registration for that role. Rotate a code by changing it here.
STAFF_INVITE_CODE=
ADMIN_INVITE_CODE=
# Comma-separated email domains allowed to register. Default: gmail.com,googlemail.com
STAFF_EMAIL_DOMAINS=
# Staff accounts are stored in Neon. Production needs DATABASE_URL, otherwise registration and login return 503.
# Demo clients (cli-1, cli-2) are blocked in production unless ALLOW_DEMO_ACCESS=true.
ALLOW_DEMO_ACCESS=
